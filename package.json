{
  "name": "remixapp",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:app": "pnpm --filter @remixapp/app dev",
    "dev:example": "pnpm --filter remixapp-example dev",
    "dev:cli": "pnpm --filter @remixapp/cli exec tsup --watch",
    "dev:sdk": "pnpm --filter @remixapp/sdk exec tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:linked": "concurrently --kill-others-on-fail --names CLI,SDK \"pnpm run dev:cli\" \"pnpm run dev:sdk\"",
    "build:app": "pnpm --filter @remixapp/app build",
    "build:cli": "pnpm --filter @remixapp/cli build",
    "build:create": "pnpm --filter @remixapp/create build",
    "build:core": "pnpm --filter @remixapp/core build",
    "build:runtime": "pnpm --filter @remixapp/runtime build",
    "build:sdk": "pnpm --filter @remixapp/sdk build",
    "build:example": "pnpm --filter remixapp-example build",
    "build:example:unpack": "pnpm --filter remixapp-example build:unpack",
    "cap:sync": "pnpm --filter @remixapp/app cap:sync",
    "android": "pnpm --filter @remixapp/app android",
    "android:dev": "node scripts/android-dev.mjs",
    "android:build": "pnpm --filter @remixapp/app android:build",
    "android:install": "node scripts/install-android-app.mjs",
    "android:install:all": "node scripts/install-android-app.mjs --all",
    "android:update": "pnpm run build:app & pnpm cap:sync & pnpm run android:build & pnpm run android:install",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:check": "node scripts/release/check.mjs",
    "release:start": "node scripts/release/start.mjs",
    "release:sync": "node scripts/release/versions.mjs sync"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.4",
      "nanoid@3.3.17": "3.3.18",
      "postcss@8": "8.5.23"
    }
  }
}

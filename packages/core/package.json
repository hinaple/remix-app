{
  "name": "@remixapp/core",
  "version": "0.3.1",
  "description": "Native device bridge for the remixApp Host",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "android/src/main",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hinaple/remix-app.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hinaple/remix-app#readme",
  "bugs": {
    "url": "https://github.com/hinaple/remix-app/issues"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}

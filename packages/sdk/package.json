{
  "name": "@remixapp/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK and project contracts for remixApp",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hinaple/remix-app.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/hinaple/remix-app#readme",
  "bugs": {
    "url": "https://github.com/hinaple/remix-app/issues"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}

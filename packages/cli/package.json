{
  "name": "@remixapp/cli",
  "version": "0.3.0",
  "description": "Build, develop, and deploy remixApp projects",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./dev-runtime": {
      "types": "./dist/dev-runtime/index.d.ts",
      "import": "./dist/dev-runtime/index.js"
    }
  },
  "bin": {
    "remix-cli": "index.js"
  },
  "files": [
    "index.js",
    "dist",
    "android-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hinaple/remix-app.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hinaple/remix-app#readme",
  "bugs": {
    "url": "https://github.com/hinaple/remix-app/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@remixapp/sdk": "0.3.0",
    "archiver": "^7.0.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@remixapp/runtime": "0.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1"
  }
}
